{
  "board": "esp32-controller",
  "name": "ESP32-Controller",
  "pins": {
    "0": {
      "name": "GPIO0",
      "capabilities": ["digital", "pwm", "interrupt", "adc1"],
      "special": ["Joystick Left Button"],
      "reserved": false,
      "notes": "Boot pin - hold LOW during boot for download mode"
    },
    "1": {
      "name": "GPIO1",
      "capabilities": ["digital", "pwm", "interrupt", "adc1"],
      "special": ["Joystick Left X"],
      "reserved": false,
      "notes": "Analog input for left joystick X-axis"
    },
    "2": {
      "name": "GPIO2",
      "capabilities": ["digital", "pwm", "interrupt", "adc1"],
      "special": ["Joystick Left Y"],
      "reserved": false,
      "notes": "Analog input for left joystick Y-axis"
    },
    "3": {
      "name": "GPIO3",
      "capabilities": ["digital", "pwm", "interrupt", "adc1"],
      "special": ["Joystick Right Button"],
      "reserved": false,
      "notes": "Right joystick button"
    },
    "4": {
      "name": "GPIO4",
      "capabilities": ["digital", "pwm", "interrupt", "adc1"],
      "special": ["Joystick Right X"],
      "reserved": false,
      "notes": "Analog input for right joystick X-axis"
    },
    "5": {
      "name": "GPIO5",
      "capabilities": ["digital", "pwm", "interrupt", "adc1"],
      "special": ["I2C SDA (OLED)"],
      "reserved": true,
      "notes": "I2C Data - OLED Display (reserved)"
    },
    "6": {
      "name": "GPIO6",
      "capabilities": ["digital", "pwm", "interrupt", "adc1"],
      "special": ["I2C SCL (OLED)"],
      "reserved": true,
      "notes": "I2C Clock - OLED Display (reserved)"
    },
    "7": {
      "name": "GPIO7",
      "capabilities": ["digital", "pwm", "interrupt", "adc1"],
      "special": ["Extra Button 2"],
      "reserved": false,
      "notes": null
    },
    "8": {
      "name": "GPIO8",
      "capabilities": ["digital", "pwm", "interrupt", "adc1"],
      "special": ["Internal LED", "Extra Button 3"],
      "reserved": false,
      "notes": "Built-in LED (active LOW) - shared with Extra Button 3"
    },
    "9": {
      "name": "GPIO9",
      "capabilities": ["digital", "pwm", "interrupt", "adc1"],
      "special": ["BOOT Button", "Extra Button 4"],
      "reserved": false,
      "notes": "BOOT Button - shared with Extra Button 4"
    },
    "10": {
      "name": "GPIO10",
      "capabilities": ["digital", "pwm", "interrupt", "adc1"],
      "special": ["Joystick Right Y"],
      "reserved": false,
      "notes": "Analog input for right joystick Y-axis"
    },
    "11": {
      "name": "GPIO11",
      "capabilities": ["digital", "pwm", "interrupt", "adc2"],
      "special": [],
      "reserved": false,
      "notes": "ADC2 - not usable with WiFi"
    },
    "12": {
      "name": "GPIO12",
      "capabilities": ["digital", "pwm", "interrupt", "adc2"],
      "special": [],
      "reserved": false,
      "notes": "ADC2 - not usable with WiFi"
    },
    "13": {
      "name": "GPIO13",
      "capabilities": ["digital", "pwm", "interrupt", "adc2"],
      "special": [],
      "reserved": false,
      "notes": "ADC2 - not usable with WiFi"
    },
    "14": {
      "name": "GPIO14",
      "capabilities": ["digital", "pwm", "interrupt", "adc2"],
      "special": [],
      "reserved": false,
      "notes": "ADC2 - not usable with WiFi"
    },
    "15": {
      "name": "GPIO15",
      "capabilities": ["digital", "pwm", "interrupt", "adc2"],
      "special": [],
      "reserved": false,
      "notes": "ADC2 - not usable with WiFi"
    },
    "16": {
      "name": "GPIO16",
      "capabilities": ["digital", "pwm", "interrupt", "adc2"],
      "special": [],
      "reserved": false,
      "notes": "ADC2 - not usable with WiFi"
    },
    "17": {
      "name": "GPIO17",
      "capabilities": ["digital", "pwm", "interrupt", "adc2"],
      "special": [],
      "reserved": false,
      "notes": "ADC2 - not usable with WiFi"
    },
    "18": {
      "name": "GPIO18",
      "capabilities": ["digital", "pwm", "interrupt", "adc2"],
      "special": [],
      "reserved": false,
      "notes": "ADC2 - not usable with WiFi"
    },
    "19": {
      "name": "GPIO19",
      "capabilities": ["digital", "pwm", "interrupt", "adc2"],
      "special": [],
      "reserved": false,
      "notes": "ADC2 - not usable with WiFi"
    },
    "20": {
      "name": "GPIO20",
      "capabilities": ["digital", "pwm", "interrupt", "adc2"],
      "special": ["Haptic Motor", "UART RX"],
      "reserved": false,
      "notes": "Haptic motor control - WARNING: Disables Serial RX when used"
    },
    "21": {
      "name": "GPIO21",
      "capabilities": ["digital", "pwm", "interrupt", "adc2"],
      "special": ["Extra Button 1", "UART TX"],
      "reserved": false,
      "notes": "Extra Button 1 - WARNING: Disables Serial TX when used"
    }
  },
  "oled": {
    "width": 72,
    "height": 40,
    "bufferWidth": 128,
    "bufferHeight": 64,
    "xOffset": 28,
    "yOffset": 24,
    "i2cAddress": "0x3C",
    "sdaPin": 5,
    "sclPin": 6
  },
  "led": {
    "pin": 8,
    "activeLow": true
  },
  "button": {
    "bootPin": 9,
    "activeLow": true
  },
  "legend": {
    "digital": "Digital I/O",
    "pwm": "PWM Output (LEDC)",
    "adc1": "Analog Read (ADC1)",
    "adc2": "Analog Read (ADC2 - not with WiFi)",
    "interrupt": "External Interrupt",
    "i2c_sda": "I2C Data",
    "i2c_scl": "I2C Clock",
    "uart_tx": "UART Transmit",
    "uart_rx": "UART Receive"
  },
  "notes": {
    "adc2_warning": "ADC2 pins cannot be used when WiFi is active",
    "boot_pins": "GPIO0, GPIO9 are boot configuration pins",
    "serial_warning": "GPIO20 (RX) and GPIO21 (TX) are shared with Serial - using them disables Serial"
  }
}
